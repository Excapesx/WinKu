{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinKu",
  "version": "1.0.0",
  "identifier": "io.github.excapesx.winku.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "WinKu",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600,
        "backgroundColor": "#f7f7f9",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "../runtime/": "runtime/", "../engine/": "engine/" },
    "shortDescription": "WinKu 学习助手",
    "copyright": "WinKu contributors",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      }
    }
  }
}
