{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinKu",
  "version": "1.0.1",
  "identifier": "io.github.excapesx.winku.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "WinKu",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600,
        "backgroundColor": "#f7f7f9",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyM0I1M0I5QzY1RkJBMDQKUldRRXVsL0d1Vk03VWtmcVJvK0w5MElZd3lCR05UNFJEUDBHamhjYXA3aTVxdWNiQnYwZ0o4RngK",
      "endpoints": [
        "https://raw.githubusercontent.com/Excapesx/WinKu/main/apps/desktop/update/latest.json",
        "https://github.com/Excapesx/WinKu/releases/latest/download/update-windows.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "../runtime/": "runtime/", "../engine/": "engine/", "installer/NOTICES.txt": "NOTICES.txt" },
    "shortDescription": "WinKu 学习助手",
    "copyright": "WinKu contributors",
    "windows": {
      "nsis": {
        "template": "installer/WinKu.nsi",
        "installerHooks": "installer/WinKuUI.nsh",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      }
    }
  }
}
